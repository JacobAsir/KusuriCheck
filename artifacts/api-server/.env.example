# KusuriCheck Backend Environment Variables

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Optional AI providers (leave blank for mock mode)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
